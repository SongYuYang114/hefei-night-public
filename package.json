{
  "name": "hefei-night",
  "version": "1.0.0",
  "description": "合肥惊魂夜 · 3D 1v4 追逃游戏",
  "author": "Hefei Night",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "start:game": "electron . --game",
    "test": "node --test tools/test-updater.cjs",
    "test:game": "node tools/test-game.cjs",
    "test:launcher": "electron . --launcher-smoke=artifacts/launcher-smoke",
    "build": "node tools/build.cjs",
    "release:prepare": "node tools/prepare-release.cjs",
    "release:audit": "node tools/audit-release.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "games.hefeinight.desktop",
    "productName": "合肥惊魂夜",
    "asar": true,
    "directories": {
      "output": "../build-v${version}"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "release.config.json",
      "launcher/**/*",
      "dist/**/*",
      "tools/restoration-smoke.cjs",
      "tools/test-launcher-ui.cjs",
      "signaling.cjs",
      "signal-cert.pem",
      "tools/portrait-smoke.cjs",
      "tools/olo-smoke.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HefeiNight-${version}-win-x64.exe",
      "executableName": "HefeiNight",
      "signExecutable": false,
      "icon": "resources/app.ico"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "compression": "normal"
  }
}
